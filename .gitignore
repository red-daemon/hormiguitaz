## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Compiled files
*.dll
*.exe
*.pdb
*.obj
*.o

# Build directories
bin/
obj/

# NuGet
.nuget/
*.nupkg
*.snupkg

# Visual Studio cache/options
.vs/
.vscode/

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# IDE
.idea/
*.swp
*.swo

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local environment
.env
.env.local
